DATABASE_URL=postgresql://triagebox:triagebox@localhost:5432/triagebox?schema=public
MQTT_URL=mqtt://localhost:1883
PORT=3001
NODE_OFFLINE_SEC=45
BATTERY_LOW_PCT=20
CORS_ORIGIN=*
# Seconds between full station poll cycles (station CONFIG_TB_POLL_PERIOD_MS / 1000).
# NODE_OFFLINE_SEC must be >= 3x this or the backend refuses to start.
STATION_POLL_PERIOD_SEC=15
