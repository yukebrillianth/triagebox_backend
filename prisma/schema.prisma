generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  RED
  YELLOW
  GREEN
  BLACK
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

model Station {
  id               String       @id
  name             String
  status           DeviceStatus @default(OFFLINE)
  lastSeen         DateTime?
  firmware         String?
  ipAddress        String?
  mqttBrokerHost   String?
  mqttBrokerPort   Int?         @default(1883)
  notes            String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  nodes            Node[]
}

model Node {
  id               String       @id
  stationId        String
  station          Station      @relation(fields: [stationId], references: [id])
  name             String
  status           DeviceStatus @default(OFFLINE)
  rssi             Int?
  snr              Float?
  battery          Int?
  firmware         String?
  packetCount      Int          @default(0)
  lastSeen         DateTime?
  // ponytail: current victim is a plain ID to avoid a circular FK; add a relation if DB-level integrity becomes necessary.
  currentVictimId  String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([stationId])
}

model Victim {
  id              String          @id @default(cuid())
  rfid            String          @unique
  name            String?
  age             Int?
  gender          String?
  notes           String?
  currentPriority Priority?
  confidence      Float?
  reasons         Json?
  currentNodeId   String?
  firstSeen       DateTime        @default(now())
  lastUpdate      DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  vitalReadings   VitalReading[]
  triageHistory   TriageHistory[]
}

model VitalReading {
  id           String   @id @default(cuid())
  victimId     String
  victim       Victim   @relation(fields: [victimId], references: [id])
  nodeId       String
  /// Nullable because the station omits a key rather than sending 0: hr 0 is a
  /// dead patient and battery 0 is a flat node, so an invented zero would be
  /// indistinguishable from a measured one. A sensor that is not ready, or a
  /// gauge read that failed, arrives as an absent key and lands here as null.
  hr           Int?
  spo2         Int?
  rr           Int?
  bpSys        Int?
  bpDia        Int?
  battery      Int?
  priority     Priority
  confidence   Float?
  reasons      Json
  /// NORMAL / ABNORMAL / "0" / "1" from node (not raw ECG)
  ecgStatus    String?
  /// OK / ERROR / device_status uint from node
  deviceStatus String?
  deviceTs     DateTime?
  receivedAt   DateTime @default(now())

  @@index([victimId, receivedAt])
}

model TriageHistory {
  id           String   @id @default(cuid())
  victimId     String
  victim       Victim   @relation(fields: [victimId], references: [id])
  fromPriority Priority
  toPriority   Priority
  confidence   Float?
  reasons      Json?
  nodeId       String?
  createdAt    DateTime @default(now())
}

model Alert {
  id           String        @id @default(cuid())
  severity     AlertSeverity
  type         String
  message      String
  victimId     String?
  nodeId       String?
  stationId    String?
  payload      Json?
  acknowledged Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([severity, acknowledged, createdAt])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  message   String
  refs      Json?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

/// A station publishing on `triagebox/{id}/announce` whose id is not registered
/// yet. Kept out of `Station` on purpose: MQTT still never creates a device, an
/// admin does. Keyed on MAC because that is the only identity a station cannot
/// change from its own configuration.
model PendingStation {
  mac                String   @id
  announcedStationId String
  ip                 String?
  firmware           String?
  nodeCount          Int?
  firstSeen          DateTime @default(now())
  lastSeen           DateTime @updatedAt
}
